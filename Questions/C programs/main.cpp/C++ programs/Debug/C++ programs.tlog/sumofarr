#include<iostream>
using namespace std;

int sumofarr(arr,size)
{
    sum=0;
    for(int i=0;i<size;i++){
        sum=sum+arr[i];
    }
    return sum;
}
int main()
{
    int arr[],size,ans;
    cin>>size;
    cout<<"Enter values of array"<<endl;
    //Accessing Array
    for(int i=0;i<size;i++)
    {
        cin>>arr[i];
    }
    ans=sumofarr(arr,size);
    cout<<"The sum of array is :"<<ans;
}